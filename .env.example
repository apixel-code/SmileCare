# ==========================================
# SmileCare Environment Variables Template
# Copy this file to .env.local and fill in the values
# ==========================================

# Application URL (http://localhost:3000 for local dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=

# Cloudinary (Image upload and optimization)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Authentication Secret (Used for JWT sessions)
AUTH_SECRET=

# SMS Gateway (Optional for dev, booking confirmations)
SMS_API_KEY=
